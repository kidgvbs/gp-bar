{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GP Bar",
  "version": "1.0.0",
  "identifier": "dev.gpbar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "GP Bar",
        "url": "index.html",
        "width": 360,
        "height": 540,
        "minWidth": 320,
        "minHeight": 100,
        "resizable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "GlobalProtect menu bar client",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "scripts/gp-admin": "scripts/gp-admin",
      "scripts/setup-admin.sh": "scripts/setup-admin.sh"
    }
  }
}
