#!/bin/sh
# GP Bar privileged helper — the only executable /etc/sudoers.d/gp-bar
# allows the user to run as root without a password (installed root-owned
# 0755 by scripts/setup-admin.sh, together with the worker binaries it
# executes, under /Library/PrivilegedHelperTools/gp-bar).
#
# This file IS the security boundary, hence the rules:
#   * fixed operations only:
#       selftest | start <portal> <0|1> [gateway|-] | stop | cancel | repair
#   * every argument is validated here — the caller is untrusted input
#   * no caller-controlled paths, no eval, no sh -c of interpolated strings
#   * the launchd job plist is fully generated from validated values, so a
#     user-writable staging file can never become arbitrary root execution
#   * every executable this script runs as root is resolved from the
#     root-owned install prefix ONLY — never from PATH, Homebrew or
#     /Applications — and refuses to start unless the file, its realpath
#     target and every parent directory are root-owned and not
#     group/world-writable (see `require_root_owned`)
#
# Honest trust model with NOPASSWD on this path:
#   * granted: running the fixed operations above, which toggle the VPN
#     and touch root-owned files (/Library/Logs/gp-bar, the job plist,
#     network DNS settings while repairing)
#   * closed: the wrapper and the gpclient binaries it executes are
#     root-owned copies outside Homebrew and the app bundles; the connect
#     log lives in a root-owned directory (no symlinked truncation of
#     user-chosen system files); sudoers is written atomically after
#     validation (see setup-admin.sh)
#   * residual: `repair` clears manual DNS on network services (that is
#     its job); anything running as this user can toggle the VPN on/off.
#     The copied binaries' own @executable_path dylibs are copied and
#     root-owned too, so the exec chain is closed on this machine; if a
#     future gpclient build links user-writable dylibs absolutely, that
#     would re-open the hole (setup-admin copies only what otool shows
#     today — re-run it after every brew/app upgrade).

set -eu

PREFIX='/Library/PrivilegedHelperTools/gp-bar'
DAEMON_DIR='/Library/Application Support/GP Bar'
PLIST="$DAEMON_DIR/dev.gpbar.worker.plist"
LOCK=/var/run/gpclient.lock
LOG_DIR=/Library/Logs/gp-bar
LOG_PATH="$LOG_DIR/gpclient-connect.log"

# The worker binaries resolve from the root-owned install prefix only.
# setup-admin.sh copies gpclient (with its Frameworks dylibs) and the whole
# "GP Connect Login.app" bundle (gpauth's SAML drop-in) here; nothing under
# /opt/homebrew, /usr/local or /Applications is ever executed as root by
# this script. $PREFIX/bin/gpauth is a RELATIVE symlink into the bundle:
# gpauth is Hardened Runtime and its code signature validates against its
# bundle context (Info.plist + _CodeSignature), so it must exec through
# the bundle layout, never as a bare Mach-O.
GPCLIENT="$PREFIX/bin/gpclient"
GPAUTH="$PREFIX/bin/gpauth"
GPLOGIN_APP="$PREFIX/GP Connect Login.app"

die() { echo "gp-admin: $*" >&2; exit 1; }

# Refuse to run unless `path` (symlink-resolved) and EVERY component of
# its directory chain is owned by root and not group/world-writable.
# A user-writable parent (or a user-swappable file) would make the
# NOPASSWD grant equivalent to arbitrary root execution.
# Symlinks: on macOS `stat -f` without -L stats the LINK ITSELF (lstat),
# so the first check below covers the link; `realpath` then resolves it
# and the walk covers the target and its whole parent chain.
require_root_owned() {
  if [ -L "$1" ]; then
    [ "$(stat -f %u "$1")" = 0 ] || die "symlink $1 is not root-owned"
  fi
  real=$(realpath "$1") || die "cannot resolve $1"
  d=$real
  while :; do
    [ "$(stat -f %u "$d")" = 0 ] || die "$d is not root-owned — re-run setup-admin.sh"
    case "$(stat -f %Sp "$d")" in
      ?????w????|????????w?) die "$d is group/world-writable — re-run setup-admin.sh" ;;
    esac
    [ "$d" = / ] && break
    d=$(dirname "$d")
  done
}

# Strict charset: also keeps the value XML-safe for the job plist. Shared
# by portal and gateway names (both end up in the job plist). A leading
# '-' is rejected: gpclient's option parser would read it as an option
# (argument injection), and '-' collides with the "auto-gateway"
# sentinel below.
valid_name() {
  case "$1" in
    ''|-*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# Name of the network service currently carrying the default route, the one
# vpnc-script reconfigures while the tunnel is up.
active_service() {
  primary_if=$(printf 'show State:/Network/Global/IPv4\n' | /usr/sbin/scutil | awk '/PrimaryInterface/ {print $3}')
  [ -n "$primary_if" ] || return 1
  /usr/sbin/networksetup -listnetworkserviceorder | awk -v dev="$primary_if" '
    /^\([^)]*\) / { svc = $0; sub(/^\([^)]*\) /, "", svc) }
    /Device: / {
      if (match($0, /Device: [A-Za-z0-9]+/)) {
        d = substr($0, RSTART+8, RLENGTH-8)
        if (d == dev) { print svc; exit }
      }
    }'
}

# Manual IPv4 DNS servers set on a service, one per line (empty when none).
# vpnc-script writes only IPv4 DNS (INTERNAL_IP4_DNS), so this is also the
# VPN-leftover signature.
service_dns() {
  /usr/sbin/networksetup -getdnsservers "$1" 2>/dev/null \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || true
}

# Manual IPv6 DNS servers set on a service, one per line (empty when none).
# An IPv6 literal always contains a colon, an IPv4 one never does. vpnc-script
# never writes v6, but its teardown (`-setdnsservers <svc> Empty`) clears ALL
# manual DNS — so the snapshot must record the user's v6 too, or a repair that
# restores only v4 would silently drop them.
service_dns6() {
  /usr/sbin/networksetup -getdnsservers "$1" 2>/dev/null \
    | grep -E '^[0-9A-Fa-f:]+$' | grep ':' || true
}

# Snapshot format (dns-snapshot.txt, written atomically by `start`):
#   line 1:      the network service the pre-VPN DNS was captured on
#   until ipv6:  the manual IPv4 servers (pre-VPN state)
#   after ipv6:: the manual IPv6 servers (pre-VPN state)
# Flat lines, shell-grep-able.
SNAPSHOT="$DAEMON_DIR/dns-snapshot.txt"

snapshot_svc() {
  [ -s "$SNAPSHOT" ] || return 1
  head -n 1 "$SNAPSHOT"
}

# The snapshot's IPv4 / IPv6 server lists.
snapshot_v4() {
  sed '1d' "$SNAPSHOT" | sed '/^ipv6:$/,$d' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || true
}

snapshot_v6() {
  sed -n '/^ipv6:$/,$p' "$SNAPSHOT" | sed '1d' \
    | grep -E '^[0-9A-Fa-f:]+$' || true
}

# The current manual DNS of `svc` as one normalized, sorted string.
current_dns() {
  { service_dns "$1"; service_dns6 "$1"; } | sort | tr '\n' ' '
}

# The snapshot's DNS as one normalized, sorted string (v4 + v6).
snapshot_dns() {
  { snapshot_v4; snapshot_v6; } | sort | tr '\n' ' '
}

# Write the pre-VPN snapshot for `svc` atomically (temp + rename).
write_snapshot() {
  {
    echo "$1"
    service_dns "$1"
    echo "ipv6:"
    service_dns6 "$1"
  } > "$SNAPSHOT.tmp"
  mv -f "$SNAPSHOT.tmp" "$SNAPSHOT"
}

# Resolve the root-owned worker binary and verify the whole ownership
# chain before any privileged use.
require_gpclient() {
  [ -x "$GPCLIENT" ] || die "gpclient not installed at $GPCLIENT — re-run setup-admin.sh"
  require_root_owned "$GPCLIENT"
}

op="${1:-}"

case "$op" in
selftest)
  require_gpclient
  # The SAML drop-in helper: gpclient resolves it as a sibling of its own
  # executable, so it must exist as the bundle-backed symlink. It is
  # Hardened Runtime — exec'ing a bare Mach-O copy dies with SIGKILL at
  # exec (bundle-context signature validation), so the bundle layout is
  # not optional. Fail loud if it is missing.
  [ -L "$GPAUTH" ] || die "gpauth symlink missing at $GPAUTH — re-run setup-admin.sh"
  require_root_owned "$GPAUTH"
  [ -d "$GPLOGIN_APP" ] || die "GP Connect Login.app bundle missing at $GPLOGIN_APP — re-run setup-admin.sh"
  require_root_owned "$GPLOGIN_APP"
  mkdir -p "$DAEMON_DIR" 2>/dev/null || die "cannot create $DAEMON_DIR"
  install -d -m 0755 -o root -g wheel "$LOG_DIR"
  echo ok
  ;;

start)
  portal="${2:-}"
  reuse="${3:-0}"
  gateway="${4:--}"
  valid_name "$portal" || die "invalid portal name"
  if [ "$reuse" != 0 ] && [ "$reuse" != 1 ]; then die "invalid reuse flag"; fi
  if [ "$gateway" != "-" ]; then
    valid_name "$gateway" || die "invalid gateway name"
  fi
  require_gpclient
  # The invoking user comes from sudo itself (SUDO_UID/SUDO_USER): the
  # caller cannot fake these, and with fast user switching /dev/console
  # names whoever is in front of the screen, not who ran sudo.
  uid="${SUDO_UID:?must run via sudo}"
  case "$uid" in *[!0-9]*) die "invalid SUDO_UID" ;; esac
  user=$(id -nu "$uid") || die "no user for uid $uid"
  [ "${SUDO_USER:-}" = "$user" ] || echo "gp-admin: SUDO_USER (${SUDO_USER:-unset}) does not match uid $uid ($user); using $user" >&2

  install -d -m 0755 -o root -g wheel "$DAEMON_DIR"
  install -d -m 0755 -o root -g wheel "$LOG_DIR"
  require_root_owned "$LOG_DIR"

  # A leftover lock from a crashed worker (or a forced reboot) would make the
  # next gpclient refuse to start ("another instance is running"). If the PID
  # it names is gone, the lock is stale: remove it before starting. We are
  # root here, so kill -0 sees root PIDs too. An EMPTY or garbage lock file
  # names no checkable PID (a crashed/truncated write): it must be removed
  # like any other stale lock, never treated as "already running" — dying
  # there would block every future start forever.
  if [ -f "$LOCK" ]; then
    old_pid=$(cat "$LOCK" 2>/dev/null || true)
    case "$old_pid" in
      ''|*[!0-9]*)
        echo "gp-admin: removing unreadable stale lock file" >&2
        rm -f "$LOCK"
        ;;
      *)
        if kill -0 "$old_pid" 2>/dev/null; then
          die "a VPN worker is already running (PID $old_pid)"
        fi
        echo "gp-admin: removing stale lock file (PID $old_pid is gone)" >&2
        rm -f "$LOCK"
        ;;
    esac
  fi

  # One log per attempt, in the root-owned world-readable log directory:
  # the panel tailer rewinds on shrink, so truncating here is the "new
  # attempt" signal. Never a user-writable path — a symlinked log under
  # ~/Library would let any user process truncate system files as root.
  rm -f "$LOG_PATH"
  : > "$LOG_PATH"
  chmod 0644 "$LOG_PATH"

  if [ "$reuse" = 1 ]; then
    cookie='<string>--cookie-cache</string>'
  else
    cookie=''
  fi
  if [ "$gateway" != "-" ]; then
    gateway_args="<string>--gateway</string><string>$gateway</string>"
  else
    gateway_args="<string>--auto-gateway</string>"
  fi

  # Snapshot the manual DNS of the service vpnc-script will reconfigure, so
  # `repair` can restore exactly the pre-VPN state if the worker ever dies
  # without a graceful disconnect (standby crash, SIGKILL, power loss).
  # Never poison it: after a crash the leftover VPN servers are still set,
  # and snapshotting THOSE as "pre-VPN state" would make a later repair
  # restore the VPN resolvers. Rules:
  #   * no snapshot yet (or one for a different service) -> take a fresh one;
  #   * same service and the current DNS differs from what the snapshot
  #     records -> the current DNS is suspected VPN leftover (or an
  #     unexplained manual change): keep the existing snapshot, warn loud;
  #   * same service and same DNS -> harmless refresh.
  if svc=$(active_service); then
    if snap=$(snapshot_svc); then
      if [ "$snap" = "$svc" ] && [ "$(current_dns "$svc")" != "$(snapshot_dns)" ]; then
        echo "gp-admin: manual DNS on '$svc' differs from the recorded pre-VPN snapshot; keeping the existing snapshot (suspected VPN leftover — run repair while the VPN is down)" >&2
      else
        write_snapshot "$svc"
      fi
    else
      write_snapshot "$svc"
    fi
  else
    echo "gp-admin: cannot resolve the active network service; DNS snapshot skipped" >&2
    [ -s "$SNAPSHOT" ] || : > "$SNAPSHOT"
  fi

  # PATH carries the root-owned bin/ FIRST and no Homebrew prefix: root
  # must not go looking for executables in user-writable directories.
  # (The worker is invoked by absolute path anyway; the PATH is for the
  # tools gpclient and vpnc-script spawn.)
  umask 022
  cat > "$PLIST" <<JOB
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.gpbar.worker</string>
<key>ProgramArguments</key><array><string>$GPCLIENT</string><string>--log-format</string><string>json</string><string>connect</string><string>$portal</string><string>--browser</string>$gateway_args$cookie</array>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>/var/root</string><key>PATH</key><string>$PREFIX/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>SUDO_UID</key><string>$uid</string><key>SUDO_USER</key><string>$user</string></dict>
<key>StandardOutPath</key><string>$LOG_PATH</string>
<key>StandardErrorPath</key><string>$LOG_PATH</string>
<key>RunAtLoad</key><true/>
<key>ExitTimeOut</key><integer>60</integer>
</dict></plist>
JOB
  chown root:wheel "$PLIST"
  chmod 0644 "$PLIST"

  # The worker must be born from launchd to stay signalable: root children
  # spawned outside launchd ignore catchable signals on this macOS beta
  # (see RECAP.md). The leading unload keeps the load idempotent and
  # recovers from a worker that exited outside GP Bar. ExitTimeOut above
  # gives the worker 60 s of SIGTERM grace at unload/bootout instead of
  # launchd's 20 s default SIGKILL — a killed worker skips the
  # vpnc-script teardown that restores DNS.
  launchctl unload -w "$PLIST" 2>/dev/null || true
  launchctl load -w "$PLIST"
  ;;

stop)
  require_gpclient
  # gpclient disconnect signals the lock-file PID with SIGINT and exits 0
  # even when the signal went nowhere: the lock file is the truth. Fail
  # loud, never SIGKILL — a killed worker skips the vpnc-script teardown
  # that restores DNS settings and routes.
  "$GPCLIENT" disconnect
  i=0
  while [ "$i" -lt 20 ] && [ -e "$LOCK" ]; do
    sleep 0.5
    i=$((i+1))
  done
  if [ -e "$LOCK" ]; then
    echo "gp-admin: the VPN worker did not stop" >&2
    exit 1
  fi
  launchctl unload -w "$PLIST" 2>/dev/null || true
  ;;

cancel)
  # Unloading the one-shot job makes launchd terminate the worker, which
  # runs its own teardown instead of a blind kill (SIGTERM first, with
  # the 60 s ExitTimeOut grace — see the plist above).
  launchctl unload -w "$PLIST" 2>/dev/null || true
  ;;

repair)
  # Restore network settings after a worker died without its graceful
  # teardown (overnight standby, crash, forced power-off): vpnc-script's
  # manual DNS servers would otherwise keep breaking name resolution.
  # Never guess: restore only from a snapshot taken on THIS service, and
  # refuse when there is nothing trustworthy to restore from.
  if [ -e "$LOCK" ]; then
    die "the VPN is up; nothing to repair"
  fi
  if pgrep -x gpclient >/dev/null 2>&1; then
    die "a gpclient worker is still running; connect/disconnect it instead"
  fi
  svc=$(active_service) || die "no active network service found"
  [ -n "$svc" ] || die "cannot resolve the active network service"
  # vpnc-script writes only IPv4 DNS, so leftover IPv4 manual servers are
  # the VPN signature; manual IPv6 alone is the user's own, left alone.
  vpn_dns=$(service_dns "$svc")
  if [ -z "$vpn_dns" ]; then
    echo "gp-admin: no stale manual DNS on '$svc'"
    exit 0
  fi
  # No snapshot: the pre-VPN state is unknown. Clearing or "restoring"
  # anything would be a guess — refuse and tell the user what to do.
  if ! snapshot_svc >/dev/null; then
    die "manual DNS on '$svc' ($vpn_dns) looks VPN-left, but no pre-VPN snapshot exists — refusing to guess. Clear it yourself: networksetup -setdnsservers '$svc' Empty (or set your own servers), then use GP Bar normally to record a fresh snapshot"
  fi
  # The snapshot must belong to the CURRENT service: a snapshot taken on
  # Wi-Fi must never be applied to Ethernet (or vice versa) after a switch.
  snap_svc=$(snapshot_svc)
  if [ "$snap_svc" != "$svc" ]; then
    die "the pre-VPN snapshot was taken on '$snap_svc', but the active service is '$svc' — restoring it here would write another service's DNS. Re-connect and disconnect the VPN on '$svc' via GP Bar to record a fresh snapshot, or set the DNS by hand: networksetup -getdnsservers '$snap_svc' shows the recorded pre-VPN servers"
  fi
  restore_v4=$(snapshot_v4)
  restore_v6=$(snapshot_v6)
  if [ -z "$restore_v4" ] && [ -z "$restore_v6" ]; then
    # The pre-VPN state had no manual DNS at all: back to DHCP defaults.
    /usr/sbin/networksetup -setdnsservers "$svc" Empty
    echo "gp-admin: cleared manual DNS on '$svc' (pre-VPN state had none)"
  else
    # Restore IPv4 AND IPv6 together — networksetup takes both in one call,
    # and a v4-only restore would drop the user's manual v6 resolvers.
    # shellcheck disable=SC2086  # word-splitting is the point: server list
    /usr/sbin/networksetup -setdnsservers "$svc" $restore_v4 $restore_v6
    echo "gp-admin: restored DNS on '$svc' to the pre-VPN setting: $restore_v4 $restore_v6"
  fi
  # The same VPN DNS can sit on services that were active during past
  # connects (docks, USB adapters, now disabled — vpnc-script never reverts
  # them if the worker died). Clear every other service carrying exactly
  # the stale IPv4 set; anything else (a user's own manual DNS) is left
  # alone.
  while IFS= read -r service; do
    [ -z "$service" ] && continue
    [ "$service" = "$svc" ] && continue
    if [ "$(service_dns "$service")" = "$vpn_dns" ]; then
      /usr/sbin/networksetup -setdnsservers "$service" Empty
      echo "gp-admin: cleared the same stale DNS on '$service'"
    fi
  done <<SERVICES
$(/usr/sbin/networksetup -listallnetworkservices | tail -n +2 | sed 's/^\*//')
SERVICES
  ;;

*)
  die "unknown operation: $op"
  ;;
esac